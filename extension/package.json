{
  "name": "ws63-ide",
  "displayName": "WS63 IDE",
  "description": "WS63 (Hi3863) build, flash, and serial monitor — ESP-IDF style workflow",
  "version": "0.5.2",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/TachengXiaochen/ws63-ide"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:build.py"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ws63.build",
        "title": "WS63: Build (Clean)",
        "category": "WS63",
        "icon": "$(refresh)"
      },
      {
        "command": "ws63.buildIncremental",
        "title": "WS63: Build (Incremental)",
        "category": "WS63",
        "icon": "$(tools)"
      },
      {
        "command": "ws63.cleanOutput",
        "title": "WS63: Clean Output",
        "category": "WS63",
        "icon": "$(clear-all)"
      },
      {
        "command": "ws63.flash",
        "title": "WS63: Flash",
        "category": "WS63",
        "icon": "$(zap)"
      },
      {
        "command": "ws63.monitor",
        "title": "WS63: Monitor",
        "category": "WS63",
        "icon": "$(output)"
      },
      {
        "command": "ws63.debugConsole",
        "title": "WS63: Debug Console",
        "category": "WS63",
        "icon": "$(debug-console)"
      },
      {
        "command": "ws63.sendSerial",
        "title": "WS63: Send Serial Command",
        "category": "WS63",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ws63.sdkConfig",
        "title": "WS63: SDK Configuration Editor",
        "category": "WS63",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ws63.quickConfig",
        "title": "WS63: Quick Config (SLE)",
        "category": "WS63",
        "icon": "$(list-selection)"
      },
      {
        "command": "ws63.newProject",
        "title": "WS63: New Application",
        "category": "WS63",
        "icon": "$(add)"
      },
      {
        "command": "ws63.menuconfig",
        "title": "WS63: Menuconfig (Terminal)",
        "category": "WS63",
        "icon": "$(list-tree)"
      },
      {
        "command": "ws63.selectPort",
        "title": "WS63: Select Port",
        "category": "WS63",
        "icon": "$(plug)"
      },
      {
        "command": "ws63.openSettings",
        "title": "WS63: Settings",
        "category": "WS63",
        "icon": "$(gear)"
      },
      {
        "command": "ws63.doctor",
        "title": "WS63: Doctor",
        "category": "WS63",
        "icon": "$(heart)"
      },
      {
        "command": "ws63.setup",
        "title": "WS63: Setup Wizard",
        "category": "WS63",
        "icon": "$(rocket)"
      },
      {
        "command": "ws63.buildFlashMonitor",
        "title": "WS63: Build + Flash + Monitor",
        "category": "WS63",
        "icon": "$(flame)"
      },
      {
        "command": "ws63.stop",
        "title": "WS63: Stop Build/Flash",
        "category": "WS63",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ws63.refreshSidebar",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "ws63": [
        {
          "id": "ws63Explorer",
          "name": "WS63"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ws63",
          "title": "WS63",
          "icon": "media/chip.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ws63.refreshSidebar",
          "when": "view == ws63Explorer",
          "group": "navigation"
        },
        {
          "command": "ws63.stop",
          "when": "view == ws63Explorer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WS63 IDE",
      "properties": {
        "ws63.sdkPath": {
          "type": "string",
          "default": "",
          "description": "SDK root (contains build.py). Leave empty to auto-detect from workspace."
        },
        "ws63.target": {
          "type": "string",
          "default": "ws63-liteos-app"
        },
        "ws63.port": {
          "type": "string",
          "default": "",
          "description": "Serial port (Windows COMx or Linux /dev/ttyUSB*). Use Select Port — do not guess COM19 on Ubuntu."
        },
        "ws63.monitorBaud": {
          "type": "number",
          "default": 115200
        },
        "ws63.flashBaud": {
          "type": "number",
          "default": 921600
        },
        "ws63.flashTimeout": {
          "type": "number",
          "default": 120,
          "description": "Flash timeout in seconds (0 = no limit). Stop button always works."
        },
        "ws63.firmwareRel": {
          "type": "string",
          "default": "output/ws63/fwpkg/ws63-liteos-app/ws63-liteos-app_all.fwpkg"
        },
        "ws63.backendPath": {
          "type": "string",
          "default": "",
          "description": "Path to ws63_cli.py directory. Leave empty to use the backend bundled in the extension."
        },
        "ws63.wslDistro": {
          "type": "string",
          "default": "Ubuntu"
        },
        "ws63.winPython": {
          "type": "string",
          "default": "",
          "description": "Windows python.exe path (WSL view e.g. /mnt/c/Users/.../python.exe). Required to open COM* from Linux/WSL. Leave empty to auto-detect."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "sync-backend": "node scripts/sync-backend.js",
    "package": "npm run sync-backend && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "license": "MIT"
}
